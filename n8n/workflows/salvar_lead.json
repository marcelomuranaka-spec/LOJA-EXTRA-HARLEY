      ],
      "parameters": {
        "jsCode": "// O agente manda só o que mudou; campo vazio mantém o valor já gravado.\nconst novo = $('Entrada').first().json;\nconst atual = $input.first().json;\nconst lead = { telegram_id: String(novo.telegram_id) };\nfor (const campo of [\"nome\", \"telefone\", \"moto_interesse\", \"forma_pagamento\", \"perfil\", \"status\", \"agendamento\", \"observacoes\"]) {\n  const valor = novo[campo] == null ? '' : String(novo[campo]).trim();\n  lead[campo] = valor || atual[campo] || '';\n}\nif (!lead.status) lead.status = 'novo';\nreturn [{ json: lead }];\n"
      }
