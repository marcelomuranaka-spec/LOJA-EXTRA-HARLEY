      ],
      "parameters": {
        "jsCode": "// Só motos à venda e só dados que o cliente pode ver: sem preço de compra,\n// placa, chassi, dono anterior nem observações internas.\nconst busca = String($('Entrada').first().json.busca ?? '').toLowerCase().trim();\nconst termos = busca.split(/\\s+/).filter(Boolean);\nconst aVenda = $input.all().map(i => i.json)\n  .filter(m => m.id && ['Em estoque', 'Consignada'].includes(m.status || 'Em estoque'))\n  .map(m => ({\n    marca: m.marca || '',\n    modelo: m.modelo || '',\n    ano: m.ano || null,\n    cor: m.cor || '',\n    quilometragem: m.quilometragem ?? null,\n    preco_venda: m.preco_venda || null,\n    foto: m.foto?.url || '',\n  }));\nconst motos = aVenda.filter(m => termos.every(t => `${m.marca} ${m.modelo} ${m.ano ?? ''} ${m.cor}`.toLowerCase().includes(t)));\nreturn [{ json: {\n  busca,\n  total_encontradas: motos.length,\n  total_a_venda: aVenda.length,\n  aviso: 'preco_venda null significa preço não cadastrado: verificar com a equipe.',\n  motos,\n} }];\n"
      }
    }
